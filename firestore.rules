// قواعد أمان Firestore لمشروع level7tailor — تطبيق LEVEL72026 + تطبيق الجودة (qc/)
// مستقلة تماماً عن مشروع level7alaa (تطبيق alaa202601)
// انشرها من: Firebase Console ← level7tailor ← Firestore Database ← Rules ← الصق ← Publish
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // فهرس أسماء المستخدمين: قراءة عامة (لازمة لتسجيل الدخول بالاسم قبل المصادقة)
    match /usernames/{name} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ملفات المنشآت: قراءة عامة (لعارض QR ولوحة الإدارة)، والكتابة للمسجّلين فقط
    match /accounts/{tid} {
      allow read: if true;
      allow write: if request.auth != null;

      match /backups/{day} {
        allow read, write: if request.auth != null;
      }
    }

    // موظفو المنشآت: للمسجّلين فقط
    match /members/{uid} {
      allow read, write: if request.auth != null;
    }

    // ═══ تطبيق متابعة الجودة (qc/) — مجموعاته مستقلة وكلها للمسجّلين فقط
    match /qc_workspaces/{id} {
      allow read, write: if request.auth != null;
    }
    match /qc_members/{id} {
      allow read, write: if request.auth != null;
    }
    match /qc_factories/{id} {
      allow read, write: if request.auth != null;
    }
    match /qc_orders/{id} {
      allow read, write: if request.auth != null;
    }
    match /qc_inspections/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
